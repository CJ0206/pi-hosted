{
  "title": "Zulip",
  "name": "zulip-single",
  "type": 1,
  "platform": "linux",
  "categories": [
    "Chat",
    "Tools"
  ],
  "description": "Single-container Zulip server for testing or small deployments. Includes SMTP support for any external mail relay.",
  "logo": "https://zulip.com/static/images/logo/zulip-icon-128x128.png",
  "image_amd64": "zulip/docker-zulip:latest",
  "restart_policy": "unless-stopped",

  "env": [
    {
      "name": "SETTINGS_FLAVOR",
      "label": "Settings Flavor",
      "default": "development",
      "description": "Use 'development' for testing or 'production' for real deployments."
    },
    {
      "name": "ZULIP_ADMIN_EMAIL",
      "label": "Admin Email",
      "default": "admin@example.com",
      "description": "Email for the initial Zulip administrator account."
    },
    {
      "name": "ZULIP_ADMIN_PASSWORD",
      "label": "Admin Password",
      "default": "changeme",
      "description": "Password for the initial Zulip administrator account."
    },
    {
      "name": "ZULIP_HOST",
      "label": "Zulip Hostname",
      "default": "zulip.local",
      "description": "Hostname users will access Zulip at."
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "default": "Europe/London",
      "description": "Timezone for the container."
    },

    {
      "name": "EMAIL_HOST",
      "label": "SMTP Host",
      "default": "smtp.zoho.eu",
      "description": "SMTP server hostname."
    },
    {
      "name": "EMAIL_PORT",
      "label": "SMTP Port",
      "default": "587",
      "description": "SMTP port (587 for TLS)."
    },
    {
      "name": "EMAIL_HOST_USER",
      "label": "SMTP Username",
      "default": "your-email@yourdomain.com",
      "description": "Your full email address."
    },
    {
      "name": "EMAIL_HOST_PASSWORD",
      "label": "SMTP Password",
      "default": "your-app-password",
      "description": "Your app-specific password."
    },
    {
      "name": "EMAIL_USE_TLS",
      "label": "Use TLS",
      "default": "true",
      "description": "Default true"
    },
    {
      "name": "EMAIL_USE_SSL",
      "label": "Use SSL",
      "default": "false",
      "description": "Default false"
    }
  ],

  "ports": [
    "80:80/tcp",
    "443:443/tcp"
  ],

  "volumes": [
    {
      "bind": "/portainer/Files/AppData/Config/zulip/data",
      "container": "/data"
    },
    {
      "bind": "/portainer/Files/AppData/Config/zulip/settings",
      "container": "/etc/zulip"
    }
  ],

  "webpage": "https://zulip.readthedocs.io/projects/docker/en/latest/",
  "officialDoc": "https://zulip.readthedocs.io/projects/docker/en/latest/how-to/compose-index.html"
}
